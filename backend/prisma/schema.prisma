generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alert_notifications {
  notification_id  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alert_id         String           @db.Uuid
  contact_id       String           @db.Uuid
  delivery_status  String?          @default("SENT") @db.VarChar(10)
  sent_at          DateTime?        @default(now()) @db.Timestamptz(6)
  alerts           alerts           @relation(fields: [alert_id], references: [alert_id], onDelete: Cascade, onUpdate: NoAction)
  trusted_contacts trusted_contacts @relation(fields: [contact_id], references: [contact_id], onDelete: Cascade, onUpdate: NoAction)
}

model alert_preferences {
  preference_id      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact_id         String           @db.Uuid
  on_crash           Boolean?         @default(true)
  on_trip_end        Boolean?         @default(false)
  on_unexpected_stop Boolean?         @default(true)
  trusted_contacts   trusted_contacts @relation(fields: [contact_id], references: [contact_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model alerts {
  alert_id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id             String                @db.Uuid
  user_id             String                @db.Uuid
  alert_type          String?               @db.VarChar(20)
  event_id            String?               @db.Uuid
  message             String?
  latitude            Decimal?              @db.Decimal(9, 6)
  longitude           Decimal?              @db.Decimal(9, 6)
  recorded_at         DateTime              @db.Timestamptz(6)
  alert_notifications alert_notifications[]
  trips               trips                 @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)
  users               users                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model badge_criteria {
  criteria_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  badge_id    String   @db.Uuid
  metric      String?  @db.VarChar(50)
  operator    String?  @db.VarChar(10)
  threshold   Decimal? @db.Decimal(10, 2)
  target      Int?
  badges      badges   @relation(fields: [badge_id], references: [badge_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model badges {
  badge_id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String           @unique @db.VarChar(100)
  description           String?
  category              String?          @db.VarChar(20)
  icon_url              String?          @db.VarChar(255)
  weekly_challenge_id   String?          @db.Uuid

  weekly_challenge      weekly_challenges?  @relation(fields: [weekly_challenge_id], references: [challenge_id], onDelete: SetNull)
  badge_criteria        badge_criteria[]
  user_badges           user_badges[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model weekly_challenges {
  challenge_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique @db.VarChar(100)
  description    String   @db.VarChar(255)
  target_trips   Int
  active         Boolean  @default(true)
  start_date     DateTime @db.Timestamptz(6)
  end_date       DateTime @db.Timestamptz(6)

  badges         badges[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leaderboard {
  leaderboard_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  category       String?   @db.VarChar(20)
  scope          String?   @db.VarChar(20)
  period_start   DateTime  @db.Date
  score          Decimal?  @default(0) @db.Decimal(10, 2)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, category, scope, period_start])
  @@index([category, scope, period_start, score])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model trip_events {
  event_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id       String   @db.Uuid
  type          String?  @db.VarChar(30)
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  severity      Decimal? @db.Decimal(5, 2)
  sensor_source String?  @db.VarChar(20)
  recorded_at   DateTime @db.Timestamptz(6)
  trips         trips    @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trip_id, recorded_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model trip_readings {
  reading_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id           String   @db.Uuid
  recorded_at       DateTime @db.Timestamptz(6)
  data_source       DataSource?  @default(OBD)
  longitude         Decimal? @db.Decimal(9, 6)
  latitude          Decimal? @db.Decimal(9, 6)
  speed_kmh         Decimal? @db.Decimal(6, 2)
  accelerometer     Decimal? @db.Decimal(8, 4)
  gyroscope_x       Decimal? @db.Decimal(8, 4)
  gyroscope_y       Decimal? @db.Decimal(8, 4)
  gyroscope_z       Decimal? @db.Decimal(8, 4)
  rpm               Int?
  coolant_temp_c    Decimal? @db.Decimal(5, 2)
  fuel_trim_percent Decimal? @db.Decimal(5, 2)
  throttle_position Decimal? @db.Decimal(5, 2)
  dtc_codes         String[]
  trips             trips    @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)
}

model trip_scores {
  score_id      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id       String    @db.Uuid
  safety_score  Decimal?  @db.Decimal(5, 2)
  eco_score     Decimal?  @db.Decimal(5, 2)
  overall_score Decimal?  @db.Decimal(5, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  trips         trips     @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model trips {
  trip_id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String          @db.Uuid
  vehicle_id       String?         @db.Uuid
  start_time       DateTime?       @default(now()) @db.Timestamptz(6)
  end_time         DateTime?       @db.Timestamptz(6)
  start_longitude  Decimal?        @db.Decimal(9, 6)
  start_latitude   Decimal?        @db.Decimal(9, 6)
  end_longitude    Decimal?        @db.Decimal(9, 6)
  end_latitude     Decimal?        @db.Decimal(9, 6)
  route_polyline   Json?           @db.JsonB
  distance_km      Decimal?        @db.Decimal(9, 6)
  duration_minutes Int?
  fuel_estimate    Decimal?        @db.Decimal(10, 2)
  data_source      DataSource?     @default(OBD)
  status           String?         @default("IN_PROGRESS") @db.VarChar(20)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  last_longitude   Decimal?        @db.Decimal(9, 6)
  last_latitude    Decimal?        @db.Decimal(9, 6)
  last_speed_kmh   Decimal?        @db.Decimal(6, 2)
  last_recorded_at DateTime?       @db.Timestamptz(6)
  fuel_level_start Decimal?        @db.Decimal(9, 6)
  fuel_level_end   Decimal?        @db.Decimal(9, 6)

  alerts           alerts[]
  trip_events      trip_events[]
  trip_readings    trip_readings[]
  trip_scores      trip_scores[]
  trip_location_shares  trip_location_shares[]
  unusual_duration_events  unusual_duration_events[]
  unexpected_stop_events  unexpected_stop_events[]
  users            users           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  vehicles         vehicles?       @relation(fields: [vehicle_id], references: [vehicle_id], onUpdate: NoAction)
  @@index([user_id, created_at])
  @@index([user_id, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model trusted_contacts {
  contact_id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                @db.Uuid
  contact_user_id       String                @db.Uuid
  name                  String                @db.VarChar(100)
  relationship          String?               @db.VarChar(50)
  email                 String?               @db.VarChar(255)
  phone                 String?               @db.VarChar(20)
  consent_status        ConsentStatus?        @default(PENDING) 
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  alert_notifications   alert_notifications[]
  alert_preferences     alert_preferences[]
  owner_user            users                 @relation("TrustedContactsOwner", fields: [user_id], references: [user_id], onDelete: Cascade)
  contact_user          users                 @relation("TrustedContactsContactUser", fields: [contact_user_id], references: [user_id], onDelete: Cascade)
  trip_location_shares  trip_location_shares[] 

  @@unique([user_id, contact_user_id])
  @@index([user_id, consent_status])
}

model user_badges {
  user_badge_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  badge_id      String    @db.Uuid
  earned_at     DateTime? @default(now()) @db.Timestamptz(6)
  badges        badges    @relation(fields: [badge_id], references: [badge_id], onDelete: Cascade, onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, badge_id])
}

enum SystemRole{
    ADMIN
    USER
}

enum UserStatus{
  ACTIVE
  SUSPENDED
  DELETED
}

enum ConsentStatus{
  PENDING
  APPROVED
  DENIED
}

enum DataSource {
  PHONE
  OBD
}

enum NotificationType {
  TRIP_SHARED
  BADGE_UNLOCKED
  TRUSTED_CONTACT_REQUEST
  TRUSTED_CONTACT_RESPONSE
  TRIP_ALERT
  GENERAL
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username          String             @unique @db.VarChar(50)
  name              String             @db.VarChar(100)
  surname           String             @db.VarChar(100)
  email             String             @unique @db.VarChar(150)
  password_hash     String             @db.VarChar(255)
  role              SystemRole         @default(USER)
  dob               DateTime           @db.Date
  phone_number      String             @db.VarChar(20)
  phone_verified    Boolean            @default(false)
  refresh_token     String?            @db.VarChar(512)
  refresh_token_exp DateTime?          @db.Timestamptz(6)
  consent_status    Boolean?           @default(false)
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  status            UserStatus         @default(ACTIVE)
  deleted_at        DateTime?          @db.Timestamptz(6)
  alerts            alerts[]
  leaderboard       leaderboard[]
  trips             trips[]
  email_verified    Boolean            @default(false)
  verification_token  String?          @db.VarChar(255)
  password_reset_token  String?        @db.VarChar(255)
  reset_token_exp   DateTime?          @db.Timestamptz(6)
  //contacts the user owns
  trusted_contacts_owned  trusted_contacts[]  @relation("TrustedContactsOwner")
  //where a user is someone elses contact
  trusted_contacts_of_user  trusted_contacts[]  @relation("TrustedContactsContactUser")
  user_badges      user_badges[]
  users_vehicles     users_vehicles[]
  trip_location_shares  trip_location_shares[]  @relation("TripSharesOwner")
  user_devices  user_devices[]
  notifications notifications[]
}

model trip_location_shares {
  share_id      String              @id @default (dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id       String              @db.Uuid
  owner_user_id String              @db.Uuid
  contact_id    String              @db.Uuid
  shared_at     DateTime            @default(now()) @db.Timestamptz(6)
  revoked_at    DateTime?           @db.Timestamptz(6)
  trip          trips               @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  owner         users               @relation("TripSharesOwner", fields: [owner_user_id], references: [user_id], onDelete: Cascade)
  contact       trusted_contacts    @relation(fields: [contact_id], references: [contact_id], onDelete: Cascade)

  @@unique([trip_id, contact_id])
  @@index([trip_id, revoked_at])
}
model users_vehicles {
  assignment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  vehicle_id    String   @db.Uuid
  assigned_at   DateTime @default(now()) @db.Timestamptz(6)
  
  users    users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  vehicles vehicles @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  
  @@unique([user_id, vehicle_id])  // Prevents duplicate assignments
}

model vehicles {
  vehicle_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name		   String? @db.VarChar(25)
  registration String? @db.VarChar(20)
  make         String? @db.VarChar(50)
  model        String? @db.VarChar(50)
  year         Int?
  fuel_type    String? @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  trips        trips[]
  fuel_tank    Decimal       @db.Decimal(9, 6)
  fuel_efficiency Decimal?    @db.Decimal(9, 6)
  users_vehicles        users_vehicles[]
}

model user_devices {
  device_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  fcm_token   String    @unique
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model notifications {
  notification_id   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  type              NotificationType
  title             String              @db.VarChar(255)
  body              String?             
  is_read           Boolean             @default(false)
  reference_id      String?             @db.Uuid
  reference_type    String?             @db.VarChar(50)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)

  users             users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model unexpected_stop_events{
  event_id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id         String      @db.Uuid
  status          String      @db.VarChar(25)
  classification  String?     @db.VarChar(25)
  latitude        Decimal     @db.Decimal(9, 6)
  longitude       Decimal     @db.Decimal(9, 6)
  address         String?
  road_use        String[]    @default([])
  poi_category    String?     @db.VarChar(50)
  stopped_at      DateTime    @db.Timestamptz(6)
  detected_at     DateTime    @default(now()) @db.Timestamptz(6)
  check_after     DateTime    @db.Timestamptz(6)
  escalated_at    DateTime?   @db.Timestamptz(6)
  resolved_at     DateTime?   @db.Timestamptz(6)

  trips               trips                 @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, check_after])
}

model unusual_duration_events{
  event_id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trip_id         String      @db.Uuid
  expected_seconds  Int
  moving_seconds_at_flag  Int
  detected_at     DateTime    @default(now()) @db.Timestamptz(6)

  trips               trips                 @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction) 

  @@index([trip_id])  
}
